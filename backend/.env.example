# Copy this file to .env and fill in your own values.
#   cp .env.example .env

# Port the API listens on
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/farmlink
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/farmlink
MONGO_URI=

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Road routing (delivery quotes, ETAs, map lines) -------------------------
# Leave everything below blank to use the public OSRM demo server, which is
# fine for development but has a fair-use limit (about 1 request/second).
#
# ROUTING_PROVIDER: auto (default) | google | osrm | haversine
#   haversine = straight-line estimates only, no network calls (used by CI).
ROUTING_PROVIDER=
# Your own OSRM instance for production, e.g. http://osrm:5000
OSRM_URL=
# Set to use Google's Distance Matrix API instead of OSRM (billed by Google).
GOOGLE_MAPS_API_KEY=
# Give up on the routing provider after this long and fall back to straight-line.
ROUTING_TIMEOUT_MS=4000

# --- Timed jobs ---------------------------------------------------------------
# How often to auto-release escrow and move expired carrier offers on.
# 0 disables the timer (admins can still run it from the console).
SWEEP_INTERVAL_MS=60000
